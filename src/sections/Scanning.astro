---
import { Image } from "astro:assets";
import mockupScannerScreen from "../assets/mockups/scanner-view.png";
import mockupScannerScreenSmall from "../assets/mockups/scanner-view-small.webp";
---

<section id="scanning" class="overflow-x-clip">
  <div
    class="flex flex-col sm:flex-row max-w-5xl mx-auto items-center py-8 sm:py-30 md:py-40 lg:py-50"
  >
    <span class="claw-top"></span>
    <span class="claw-bottom"></span>

    <div class="sm:w-[50%]">
      <Image
        class="sm:hidden max-w-[60%] mx-auto"
        src={mockupScannerScreenSmall}
        alt="Pantalla de escaneo de la aplicación"
      />
      <Image
        class="max-sm:hidden max-h-140 mx-auto w-auto"
        src={mockupScannerScreen}
        alt="Pantalla de escaneo de la aplicación"
      />
    </div>
    <div class="p-4">
      <h2 class="sr-only">Escaneo</h2>
      <ol class="text-white">
        <li>Elegí un producto.</li>
        <li>Entrá a la función de escanear.</li>
        <li>Escaneá el código de barras.</li>
        <li>Sabé si es apto para tu consumo.</li>
      </ol>
    </div>
  </div>
</section>

<style>
  /* https://www.geeksforgeeks.org/css/how-to-customize-the-numbers-of-an-ordered-list-using-css/ */
  ol {
    counter-reset: num;

    li {
      counter-increment: num;

      display: flex;
      align-items: center;
      gap: 1rem;
      margin-bottom: 1rem;

      &::before {
        content: counter(num);

        display: grid;
        place-content: center;

        width: 2em;
        height: 2em;

        border-radius: 3em;
        background-color: #009161;
        font-weight: bold;
        font-size: 2rem;
      }
    }
  }

  section > div {
    position: relative;
    z-index: 2;

    &::before {
      content: "";
      position: absolute;
      inset: 0;
      z-index: -10;

      background-color: #005b8e;
      clip-path: ellipse(100% 102% at 100% 100%);
    }
  }

  /* GREEN CLAWS */
  .claw-top,
  .claw-bottom {
    --_claw-height: calc(100% * 224 / 960);
    --_bg: url("");

    position: absolute;
    left: 0;

    width: 100%;
    aspect-ratio: 960/224;

    background: transparent var(--_bg) center center no-repeat;
    background-size: cover;

    &::after {
      content: "";

      position: absolute;

      left: 100%;
      /* transform: translateX(64rem); */
      top: -51.5%;

      background: transparent url("../assets/green-claw-end.png") center center
        no-repeat;
      background-size: cover;

      /* Aspect ratio: 186/456 */
      aspect-ratio: 186/456;
      height: calc(100% * 456 / 224);
      /* border: 1px solid black; */
    }
  }

  .claw-top {
    --_bg: url("../assets/green-claw.png");
    top: calc(var(--_claw-height) / -4);
  }

  .claw-bottom {
    --_bg: url("../assets/green-claw.png");
    bottom: calc(var(--_claw-height) / -4);

    transform: rotateZ(180deg);
  }

  /* RIGHT SIDE BLUE (AFTER 1024PX) */
  @media (min-width: 1024px) {
    section {
      --max-container-size: 900px;
      --section-spaces: calc((100dvw - var(--max-container-size)) / 2);
      --section-space-container: calc(
        var(--section-spaces) + var(--max-container-size)
      );

      background: linear-gradient(
        90deg,
        transparent var(--section-space-container),
        #005b8e 0%
      );
    }
  }
</style>
