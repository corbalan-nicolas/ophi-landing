---
import { Image } from "astro:assets";
import mockupHomeScreen from "../assets/mockups/home-view.webp";
import mockupHomeScreenSmall from "../assets/mockups/home-view-small.webp";

const spaUrl = import.meta.env.PUBLIC_SPA_URL;
---

<div id="hero">
  <span id="gradient-left"></span>
  <span id="gradient-right"></span>
  <div
    class="grid sm:grid-cols-[70fr_30fr] max-w-5xl mx-auto min-h-150 items-center px-4"
  >
    <div
      class="text-white bg-[#005b8e] max-sm:mt-50 mb-10 sm:mb-30 animate-slide-in-left animate-duration-500"
    >
      <h1 class="sr-only">ophi</h1>
      <p class="h1 text-5xl mb-6">Elegí, Escaneá, Disfrutá.</p>

      <p class="leading-9">
        <a class="rounded-full bg-[#009161] py-2 px-4 font-bold" href={spaUrl}
          >Ir a la App</a
        > ¡Próximamente disponible en Google Play y App Store!
      </p>
    </div>
    <div class="animate-slide-in-right animate-duration-500">
      <Image
        src={mockupHomeScreenSmall}
        class="sm:hidden max-w-[60%] mx-auto"
        loading="eager"
        alt="Pantalla de inicio de la aplicación"
      />
      <Image
        src={mockupHomeScreen}
        class="max-sm:hidden max-h-130 w-auto"
        loading="eager"
        alt="Pantalla de inicio de la aplicación"
      />
    </div>
  </div>
</div>

<style>
  #hero {
    /* background: linear-gradient(#005b8e 378px, transparent 0%); */
    /* background: linear-gradient(#f5f5f5 260px, #005b8e 260px 542px, #f5f5f5 0%); */
  }

  /* Left gradient */
  #gradient-left {
    position: absolute;
    z-index: -1;
    width: 50%;
    height: 600px;

    background: linear-gradient(#005b8e 378px, transparent 0%);
  }

  #gradient-right {
    position: absolute;
    z-index: -1;
    width: 50%;
    height: 600px;
    right: 0;

    background: linear-gradient(#f5f5f5 260px, #005b8e 260px 542px, #f5f5f5 0%);
  }

  #hero > div {
    background: #f5f5f5 url("../assets/hero-bg.svg") left top no-repeat;
    background-size: cover;
  }
</style>
