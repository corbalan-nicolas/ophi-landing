---
import ophiLogoWhite from "../assets/ophi-logo-white.svg";
---

<footer class="bg-[#005b8e] text-white max-sm:pt-8">
  <div class="max-w-7xl mx-auto sm:flex justify-between items-center px-4 py-2">
    <img
      class="max-sm:mx-auto"
      loading="lazy"
      src={ophiLogoWhite.src}
      alt="Logo de ophi"
    />

    <nav
      class="max-sm:justify-center max-sm:mt-4 flex sm:gap-4 items-center font-semibold"
    >
      <a class="py-2 px-4 hover:underline" href="/terms-and-conditions"
        >Términos y condiciones</a
      >
      <a class="py-2 px-4 hover:underline" href="/policy"
        >Políticas de privacidad</a
      >
    </nav>
  </div>
</footer>
