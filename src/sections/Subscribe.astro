---
import { Image } from "astro:assets";
import mockupLoadingScreen from "../assets/mockups/loading-view.png";
import mockupLoadingScreenSmall from "../assets/mockups/loading-view-small.webp";
---

<section id="subscribe" class="py-4 bg-[#005b8e] text-white">
  <div
    class="flex flex-col-reverse sm:flex-row items-center gap-4 max-w-5xl mx-auto px-4"
  >
    <form class="sm:w-[75%]" action="#" method="post">
      <h2 class="text-center text-6xl mb-4">¡Suscribite!</h2>

      <p class="mb-4">No te pierdas ningún descuento ni promociones.</p>

      <div class="mb-4">
        <input
          id="email"
          class="bg-white rounded-t py-2 px-4 w-full placeholder:text-black/60 border-b border-b-[#009161]"
          type="email"
          name="email"
          aria-label="Correo electrónico"
          placeholder="Ingresá tu correo"
        />
      </div>

      <button
        class="rounded-full bg-[#009161] py-1 px-4 font-bold"
        type="submit">Enviar</button
      >
    </form>
    <div class="">
      <Image
        class="max-w-[60%] mx-auto sm:hidden"
        src={mockupLoadingScreenSmall}
        alt="Celular con la aplicación de ophi abierta"
      />
      <Image
        class="max-w-[50%] mx-auto max-sm:hidden"
        src={mockupLoadingScreen}
        alt="Celular con la aplicación de ophi abierta"
      />
    </div>
  </div>
</section>
