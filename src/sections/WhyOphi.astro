---
import Card from "../components/Card.astro";
---

<section id="whyOphi" class="pt-8 pb-25">
  <div class="max-w-5xl mx-auto">
    <h2 class="text-center text-6xl sm:text-8xl">
      ¿Por qué <span class="font-kalon text-[#005b8e]">ophi</span>?
    </h2>

    <div
      class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4 mt-12 px-4"
    >
      <Card
        title="100% personalizada"
        body="Elegí tu propia condición alimentaria o dieta."
      />
      <Card
        title="Segura"
        body="Basada en perfiles médicos y listas validadas."
      />
      <Card title="Simple" body="Escaneá el código de barras y ¡listo!" />
      <Card
        title="Productos nacionales"
        body="Contamos con todos los productos nacionales del mercado."
      />
    </div>
  </div>
</section>
